# Generated by configure; do not edit. Use R's site/user Makevars for compilers.
CXX_STD = CXX11

# Target-specific additions retain site/user PKG_* flags and propagate from
# R's all target to compilation and linking. OpenMP cannot be overridden away.
all: override PKG_CPPFLAGS += @SDK_CPPFLAGS@
all: override PKG_CXXFLAGS += @OPENMP_CXXFLAGS@
all: override PKG_LIBS += @SDK_LIBS@ @OPENMP_LIBS@
